{
  "name": "shadowcast",
  "version": "1.0.0",
  "description": "Decentralized client-side P2P WebRTC asset delivery CDN engine",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sw": "./dist/interception/sw.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "sideEffects": [
    "./dist/interception/sw.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/__tests__/*.test.js"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "cdn",
    "mesh",
    "datachannel",
    "asset-delivery",
    "service-worker",
    "indexeddb"
  ],
  "author": "ShadowCast Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fake-indexeddb": "6.2.8",
    "typescript": "^5.5.0"
  }
}
